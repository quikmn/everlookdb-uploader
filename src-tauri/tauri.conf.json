{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EverlookDB Uploader",
  "mainBinaryName": "everlookdb-uploader",
  "version": "0.2.0",
  "identifier": "com.everlookdb.uploader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Viktor Lundgren",
    "copyright": "Copyright (c) 2026 Viktor Lundgren. MIT License.",
    "homepage": "https://everlookdb.com/contribute.html",
    "category": "Utility",
    "shortDescription": "Uploads EverlookDB addon data to everlookdb.com",
    "longDescription": "Sits in the tray and uploads the EverlookDB addon's data file (EverlookDB.lua) to everlookdb.com whenever World of Warcraft saves it. Sends only that file's game facts.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFOTQ2OTRFMUFFNzNDNzQKUldSMFBPY2FUbW1VRGhzbkdscXFKdnlyT2ZJSkdSakVqMHZ6UCtSRDI2bDZmQXJ1dXVzMldhYTgK",
      "endpoints": ["https://everlookdb.com/uploader/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
