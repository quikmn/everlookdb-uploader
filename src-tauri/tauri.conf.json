{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EverlookDB",
  "mainBinaryName": "everlookdb-uploader",
  "version": "0.7.5",
  "identifier": "com.everlookdb.uploader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Viktor Lundgren",
    "copyright": "Copyright (c) 2026 Viktor Lundgren. GPL-3.0-or-later.",
    "homepage": "https://everlookdb.com/contribute.html",
    "category": "Utility",
    "shortDescription": "Ad-free World of Warcraft addon manager, and the EverlookDB uploader",
    "longDescription": "EverlookDB finds every World of Warcraft install, shows its version, and installs, updates and removes addons from GitHub and Tukui with no ads and no account. It also uploads the EverlookDB addons' data files (EverlookDB.lua, EverlookDBAuctions.lua) to everlookdb.com whenever the game saves them, and sends nothing else.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFOTQ2OTRFMUFFNzNDNzQKUldSMFBPY2FUbW1VRGhzbkdscXFKdnlyT2ZJSkdSakVqMHZ6UCtSRDI2bDZmQXJ1dXVzMldhYTgK",
      "endpoints": [
        "https://everlookdb.com/uploader/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
